    <string name="switch_style">专属样式</string>
    <string name="switch_style_summary">解锁 记录/导航/桌面图标皮肤</string>
    <string name="switch_share">个性化分享</string>
    <string name="switch_share_summary">解锁 分享记录-进阶数据</string>
