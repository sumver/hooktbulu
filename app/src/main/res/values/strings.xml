    <string name="settings_subtitle">当前适配版本：9.2.8</string>

    <string name="group_purify">广告净化</string>
    <string name="group_mine">「我的」页净化</string>
    <string name="group_share">增强分享卡功能</string>
    <string name="group_interact">交互优化</string>
    <string name="group_vip">解锁会员功能</string>

    <string name="switch_ads">隐藏各类广告</string>
    <string name="switch_ads_summary">开屏、信息流、轮播横幅、资讯列表、运动记录页、出游详情、插屏与弹窗广告</string>
    <string name="switch_vip_banner">隐藏会员促销横幅</string>
